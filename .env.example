# Backend Server Configuration
PORT=3000

# DSO API Configuration
DSO_API_KEY=your_dso_api_key_here
DSO_BASE_URL=https://service.omgevingswet.overheid.nl

# PDOK Locatieserver
PDOK_GEOCODE_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1/free

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Development Mode
# Set to 'true' to use mock data instead of real APIs (for testing without API keys)
# Set to 'false' or remove to use real PDOK and DSO APIs
USE_MOCK_DATA=true
